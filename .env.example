# Salin menjadi .env lalu sesuaikan.
# Compose otomatis membaca file .env di folder yang sama.

# Ganti password sebelum membuka Workamon ke jaringan.
WORKAMON_USER=admin
WORKAMON_PASSWORD=workamon

# Port di host. Ganti bila 8080 sudah dipakai, misalnya 9090.
WORKAMON_PORT=8080

# Batas ukuran database dalam MB. Data tertua dihapus otomatis.
WORKAMON_DB_MAX_MB=10

# Interval sampel sistem (detik) dan riwayat container (detik).
WORKAMON_SAMPLE_SECS=30
WORKAMON_CONTAINER_SAMPLE_SECS=300

# Masa berlaku sesi login dan retensi log aplikasi.
WORKAMON_SESSION_HOURS=168
WORKAMON_LOG_RETENTION_DAYS=14

# Zona waktu untuk tampilan tanggal.
TZ=Asia/Jakarta

# Aktifkan kontrol host: systemd, instal paket, dan terminal root host.
# Compose menjalankan container sebagai root dengan pid: host + privileged.
# Set 0 untuk mematikan fitur host dan kembali ke mode monitoring Docker saja.
WORKAMON_HOST_EXEC=1

# GID pemilik /var/run/docker.sock di host.
# Cek dengan: stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# Tingkat log. Gunakan workamon=debug untuk diagnosis lebih detail.
RUST_LOG=workamon=info,tower_http=warn,warn
